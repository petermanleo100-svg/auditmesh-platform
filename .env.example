AUDITMESH_DATABASE_URL=postgresql+psycopg://auditmesh:change-me@postgres:5432/auditmesh
AUDITMESH_ENV=production
AUDITMESH_AUTH_MODE=oidc
AUDITMESH_JWT_ISSUER=https://identity.example.com
AUDITMESH_JWT_AUDIENCE=auditmesh-api
AUDITMESH_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# Controlled pilot exception only.
AUDITMESH_JWT_SECRET=
AUDITMESH_ALLOW_HMAC_PRODUCTION=false
AUDITMESH_AUTO_CREATE_SCHEMA=false
AUDITMESH_BACKUP_KEY_BASE64=replace-with-a-base64-encoded-32-byte-key
